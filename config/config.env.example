# config/config.env.example
# Configuration file template for Homelab Diagnostic Suite

# Uptime Kuma Passive Push Monitor URL
# Create a "Push" monitor in Uptime Kuma and paste its Push URL below:
UPTIME_KUMA_PUSH_URL="https://uptime-kuma.example.com/api/push/your-push-key"

# Ollama connection URL
# - Native Linux:   leave as http://localhost:11434
# - WSL2 / Docker: use http://host.docker.internal:11434 or host IP
OLLAMA_URL="http://host.docker.internal:11434"

# Directory where status.json and history.json will be stored for dashboard serving
STATUS_DATA_DIR="$HOME/status-dashboard-data"

# Model selection for LLM diagnosis (optional, default model used if unset)
# OLLAMA_MODEL="qwen2.5-coder:7b"
